<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kalkulator Kriptografi Klasik</title>
    <!-- Tailwind CSS untuk Desain Modern -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col items-center justify-center p-4">

    <div class="max-w-4xl w-full bg-slate-800 rounded-2xl shadow-2xl p-6 md:p-8 border border-slate-700">
        <!-- Header -->
        <div class="text-center mb-8">
            <h1 class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">
                Kriptografi Klasik Suite
            </h1>
            <p class="text-slate-400 mt-2">ROT13, Atbash, dan Caesar Cipher dengan Desain Interaktif</p>
        </div>

        <!-- Input Global -->
        <div class="mb-6">
            <label class="block text-sm font-medium text-slate-300 mb-2">Teks Masukan (Plaintext / Ciphertext):</label>
            <textarea id="inputText" rows="3" 
                class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-slate-100 focus:outline-none focus:ring-2 focus:ring-cyan-500 transition" 
                placeholder="Ketik teks di sini..." oninput="prosesSemua()"></textarea>
        </div>

        <!-- Grid Cipher -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            
            <!-- 1. ROT13 Card -->
            <div class="bg-slate-900/50 border border-slate-700 rounded-xl p-4 flex flex-col justify-between">
                <div>
                    <h2 class="text-lg font-bold text-cyan-400 mb-1">ROT13</h2>
                    <p class="text-xs text-slate-400 mb-3">Geser tetap sejauh 13 huruf.</p>
                    <textarea id="outputRot13" rows="3" readonly 
                        class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-sm text-slate-300 resize-none" placeholder="Hasil..."></textarea>
                </div>
                <button onclick="salinTeks('outputRot13')" class="mt-3 bg-cyan-600 hover:bg-cyan-500 text-white text-xs py-1.5 px-3 rounded-lg transition font-medium">Salin Hasil</button>
            </div>

            <!-- 2. Atbash Card -->
            <div class="bg-slate-900/50 border border-slate-700 rounded-xl p-4 flex flex-col justify-between">
                <div>
                    <h2 class="text-lg font-bold text-cyan-400 mb-1">Atbash</h2>
                    <p class="text-xs text-slate-400 mb-3">Pembalikan alfabet (A↔Z, B↔Y).</p>
                    <textarea id="outputAtbash" rows="3" readonly 
                        class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-sm text-slate-300 resize-none" placeholder="Hasil..."></textarea>
                </div>
                <button onclick="salinTeks('outputAtbash')" class="mt-3 bg-cyan-600 hover:bg-cyan-500 text-white text-xs py-1.5 px-3 rounded-lg transition font-medium">Salin Hasil</button>
            </div>

            <!-- 3. Caesar Card -->
            <div class="bg-slate-900/50 border border-slate-700 rounded-xl p-4 flex flex-col justify-between">
                <div>
                    <div class="flex justify-between items-center mb-1">
                        <h2 class="text-lg font-bold text-cyan-400">Caesar</h2>
                        <div class="flex items-center space-x-1">
                            <span class="text-xs text-slate-400">Geser:</span>
                            <input type="number" id="caesarShift" value="3" min="1" max="25" 
                                class="w-12 bg-slate-900 border border-slate-700 text-center text-xs rounded p-1 text-cyan-400 font-bold" oninput="prosesSemua()">
                        </div>
                    </div>
                    <p class="text-xs text-slate-400 mb-3">Geser sesuai nilai Shift.</p>
                    <textarea id="outputCaesar" rows="3" readonly 
                        class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-sm text-slate-300 resize-none" placeholder="Hasil..."></textarea>
                </div>
                <button onclick="salinTeks('outputCaesar')" class="mt-3 bg-cyan-600 hover:bg-cyan-500 text-white text-xs py-1.5 px-3 rounded-lg transition font-medium">Salin Hasil</button>
            </div>

        </div>
    </div>

    <!-- JavaScript Logika Kriptografi -->
    <script>
        function rot13(str) {
            return str.replace(/[a-zA-Z]/g, function(c) {
                const base = c <= 'Z' ? 65 : 97;
                return String.fromCharCode(base + (c.charCodeAt(0) - base + 13) % 26);
            });
        }

        function atbash(str) {
            return str.replace(/[a-zA-Z]/g, function(c) {
                const base = c <= 'Z' ? 65 : 97;
                return String.fromCharCode(base + (25 - (c.charCodeAt(0) - base)));
            });
        }

        function caesar(str, shift) {
            shift = (shift % 26 + 26) % 26;
            return str.replace(/[a-zA-Z]/g, function(c) {
                const base = c <= 'Z' ? 65 : 97;
                return String.fromCharCode(base + (c.charCodeAt(0) - base + shift) % 26);
            });
        }

        function prosesSemua() {
            const input = document.getElementById('inputText').value;
            const shiftValue = parseInt(document.getElementById('caesarShift').value) || 3;

            document.getElementById('outputRot13').value = rot13(input);
            document.getElementById('outputAtbash').value = atbash(input);
            document.getElementById('outputCaesar').value = caesar(input, shiftValue);
        }

        function salinTeks(elementId) {
            const textarea = document.getElementById(elementId);
            textarea.select();
            navigator.clipboard.writeText(textarea.value);
            alert('Teks berhasil disalin!');
        }
    </script>
</body>
</html>
